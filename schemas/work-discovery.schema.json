{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pre6g.example/schemas/work-discovery.schema.json",
  "title": "Pre6G Work Discovery v1",
  "type": "object",
  "required": [
    "schema_version",
    "workload_family",
    "adapter",
    "profileable",
    "discovery_mode",
    "parameters",
    "dataset",
    "work",
    "production_input_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "pre6g.work-discovery/v1"
    },
    "workload_family": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "profileable": {
      "type": "boolean"
    },
    "discovery_mode": {
      "enum": [
        "static-semantic-contract",
        "mounted-dataset",
        "unresolved"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "additionalProperties": true
    },
    "work": {
      "type": "object",
      "required": [
        "status",
        "unit",
        "steps_per_epoch",
        "total_units",
        "source",
        "assumptions",
        "missing"
      ],
      "properties": {
        "status": {
          "enum": ["declared", "estimated", "unknown"]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "steps_per_epoch": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "total_units": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "missing": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "production_input_policy": {
      "type": "object",
      "required": [
        "uses_iterations_csv",
        "uses_nvtx",
        "uses_callbacks",
        "uses_epoch_timestamps",
        "uses_batch_timestamps"
      ],
      "properties": {
        "uses_iterations_csv": {"const": false},
        "uses_nvtx": {"const": false},
        "uses_callbacks": {"const": false},
        "uses_epoch_timestamps": {"const": false},
        "uses_batch_timestamps": {"const": false}
      }
    }
  },
  "additionalProperties": true
}
